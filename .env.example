# Mintkey — environment variable reference for docker-compose
# Copy to .env and replace placeholder values before running in production.
# In dev the docker-compose.yml contains inline defaults; override here to
# avoid editing the compose file.
#
# WARNING: never commit a .env file with real secrets. .env is gitignored.
# Use a secrets manager (Vault, AWS Secrets Manager, etc.) in production.

# ---------------------------------------------------------------------------
# Audit fingerprint HMAC key
# Used by admin-api to produce keyed HMAC-SHA256 audit fingerprints for
# credential audit-trail fields (p8_fingerprint, key_fingerprint, etc.).
# Must be a hex-encoded string of at least 32 bytes (64 hex chars).
# Generate with: openssl rand -hex 32
# Service fails to start if unset or too short.
# ---------------------------------------------------------------------------
MINTKEY_AUDIT_HMAC_KEY=REPLACE_WITH_openssl_rand_hex_32

# ---------------------------------------------------------------------------
# Audit emission service tokens (#22, #22-redux)
# Each value is a shared secret used to authenticate service-to-service calls
# to admin-api's /v1/internal/audit/emit endpoint.
# All three must be set on admin-api (allowlist) AND on the emitting service.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# admin-api allowlist (all three must be set for the endpoint to accept calls)
MINTKEY_BROKER_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32
MINTKEY_PROXY_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32
MINTKEY_MCP_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# broker — must match MINTKEY_BROKER_SERVICE_TOKEN above
# MINTKEY_BROKER_SERVICE_TOKEN=<same value>

# broker + proxy-plugin — admin-api base URL (must include port 8080)
MINTKEY_ADMIN_API_URL=http://admin-api:8080

# ---------------------------------------------------------------------------
# Audit-emit rate limiting (#26)
# Token-bucket rate limit for /v1/internal/audit/emit, applied per
# service-token bucket.  Default: 100 req/s (burst 100, sustained 100/s).
# Set to 0 to disable rate limiting entirely (useful in test environments).
# ---------------------------------------------------------------------------
MINTKEY_AUDIT_EMIT_RATE_LIMIT_RPS=100

# ---------------------------------------------------------------------------
# WAL compaction (#27)
# Controls when the background compaction worker rewrites the WAL file to
# remove tombstoned (delivered) lines.  Compaction fires when EITHER condition
# is met first (hybrid policy).
#
# MINTKEY_AUDIT_WAL_COMPACT_INTERVAL_SEC — seconds between compaction passes
#   (default: 300 / 5 minutes).  Set to 0 to disable the timer trigger.
# MINTKEY_AUDIT_WAL_COMPACT_THRESHOLD_BYTES — WAL file size in bytes that
#   immediately triggers compaction (default: 67108864 / 64 MiB).
#   Set to 0 to disable the size trigger.
#
# Override to a shorter interval during initial rollout for faster observability:
# MINTKEY_AUDIT_WAL_COMPACT_INTERVAL_SEC=30
# ---------------------------------------------------------------------------
MINTKEY_AUDIT_WAL_COMPACT_INTERVAL_SEC=300
MINTKEY_AUDIT_WAL_COMPACT_THRESHOLD_BYTES=67108864

# ---------------------------------------------------------------------------
# Public-facing URLs (see docs/NETWORK.md)
# Set these to the URLs that agents and operators on OTHER machines will reach.
# Defaults (localhost) only work when every client runs on the same host as
# the stack. MCP and proxy may use different IPs/hostnames.
# ---------------------------------------------------------------------------
# LAN example (single host, accessible via LAN IP):
# MINTKEY_MCP_PUBLIC_URL=http://192.168.1.50:8082
# MINTKEY_PROXY_PUBLIC_URL=http://192.168.1.50:8000

# Cloud example (TLS-terminating reverse proxy in front; different hosts):
# MINTKEY_MCP_PUBLIC_URL=https://mcp.example.com
# MINTKEY_PROXY_PUBLIC_URL=https://proxy.example.com

# ---------------------------------------------------------------------------
# Keycloak + admin-ui/api SSO URLs (see docs/NETWORK.md and docs/AUTH.md)
# Browser-facing URLs MUST be reachable from operator browsers; *_INTERNAL_URL
# is what containers use to talk to Keycloak from inside the docker network
# (defaults to docker service name + port, works for `docker compose up`).
# ---------------------------------------------------------------------------
# ---------------------------------------------------------------------------
# SSH-proxy (bastion) ports and vault identity
# ---------------------------------------------------------------------------
# SSH listen port on the host (default 2222 — change if another sshd occupies it)
MINTKEY_SSH_PROXY_PORT=2222
# HTTP port on the host for ssh-proxy healthz + metrics (default 8089)
# NOTE: 8088 is reserved for cAdvisor — do not use that value here.
MINTKEY_SSH_PROXY_HTTP_PORT=8089
# Vault-adapter service identity for ssh-proxy.
# Both ssh-proxy and vault-adapter MUST carry the SAME value.
# Override in production via a secret manager; never commit a real secret here.
MINTKEY_VAULT_SSH_PROXY_IDENTITY_ID=svcid_ssh_proxy
MINTKEY_VAULT_SSH_PROXY_TOKEN=mk_vault_ssh_proxy_dev_shared_secret!
# Auto-generate the SSH host key on first start in dev/CI (fresh volume = no key).
# Set to false in production and seed the key explicitly via `make ssh-proxy-init`.
SSH_PROXY_HOST_KEY_GENERATE=true

# ---------------------------------------------------------------------------
# Email-proxy (REST bastion) ports (ADR-0024 / C-11)
# ---------------------------------------------------------------------------
# REST API + healthz port on the host (default 8091; 8088 is reserved for cAdvisor)
# Container-internal listen port is always 8088; this controls the host mapping.
MINTKEY_EMAIL_PROXY_HTTP_PORT=8091
# Prometheus metrics port on the host (default 8092)
MINTKEY_EMAIL_PROXY_METRICS_PORT=8092

# ---------------------------------------------------------------------------
# Email-proxy OAuth2 client credentials (ADR-0024, C-9)
# admin-api holds these; they are NEVER passed to email-proxy or stored in vault.
# Generate OAuth2 apps at:
#   Gmail:   https://console.cloud.google.com/ → Credentials → OAuth 2.0 Client IDs
#   Outlook: https://portal.azure.com/ → App registrations
# ---------------------------------------------------------------------------
MINTKEY_OAUTH2_GMAIL_CLIENT_ID=REPLACE_WITH_gmail_oauth2_client_id
MINTKEY_OAUTH2_GMAIL_CLIENT_SECRET=REPLACE_WITH_gmail_oauth2_client_secret
MINTKEY_OAUTH2_OUTLOOK_CLIENT_ID=REPLACE_WITH_outlook_oauth2_client_id
MINTKEY_OAUTH2_OUTLOOK_CLIENT_SECRET=REPLACE_WITH_outlook_oauth2_client_secret

# ---------------------------------------------------------------------------
# Email-proxy vault identity (ADR-0024, OQ-2 — mirrors ssh-proxy pattern)
# email-proxy uses these to authenticate to vault-adapter for refresh_token
# retrieval (auth health checks + future direct-vault paths).
# Provision: scripts/dev-install.sh (or install.sh) writes these after
# registering an AppRole identity for email-proxy in vault-adapter.
# ---------------------------------------------------------------------------
MINTKEY_VAULT_EMAIL_PROXY_IDENTITY_ID=svcid_email_proxy
MINTKEY_VAULT_EMAIL_PROXY_TOKEN=mk_vault_email_proxy_dev_shared_secret!

# ---------------------------------------------------------------------------
# Email-proxy service-to-service token
# Used by email-proxy to authenticate calls to admin-api's
# /v1/internal/oauth2/{provider}/refresh endpoint.
# Must match MINTKEY_EMAIL_PROXY_SERVICE_TOKEN on both sides.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------
MINTKEY_EMAIL_PROXY_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# Keycloak — browser-facing (the URL the operator types into the browser):
# MINTKEY_KEYCLOAK_PUBLIC_URL=http://10.243.1.200:8443
# Keycloak — server-to-server (admin-api / Grafana / oauth2-proxy → Keycloak):
# MINTKEY_KEYCLOAK_INTERNAL_URL=http://keycloak:8443

# admin-ui (browser-facing) — used by admin-api as OIDC redirect target:
# MINTKEY_ADMIN_UI_PUBLIC_URL=http://10.243.1.200:8081
# admin-api (browser-facing) — used by admin-ui when it links to OIDC endpoints:
# MINTKEY_ADMIN_API_PUBLIC_URL=http://10.243.1.200:8080
# Grafana (browser-facing) — used for OIDC redirect URI:
# MINTKEY_GRAFANA_PUBLIC_URL=http://10.243.1.200:3003
# Jaeger (browser-facing) — used by oauth2-proxy as OIDC redirect URI:
# MINTKEY_JAEGER_PUBLIC_URL=http://10.243.1.200:16686
