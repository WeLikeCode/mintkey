# Mintkey — environment variable reference for docker-compose
# Copy to .env and replace placeholder values before running in production.
# In dev the docker-compose.yml contains inline defaults; override here to
# avoid editing the compose file.
#
# WARNING: never commit a .env file with real secrets. .env is gitignored.
# Use a secrets manager (Vault, AWS Secrets Manager, etc.) in production.

# ---------------------------------------------------------------------------
# Audit emission service tokens (#22, #22-redux)
# Each value is a shared secret used to authenticate service-to-service calls
# to admin-api's /v1/internal/audit/emit endpoint.
# All three must be set on admin-api (allowlist) AND on the emitting service.
# Generate with: openssl rand -hex 32
# ---------------------------------------------------------------------------

# admin-api allowlist (all three must be set for the endpoint to accept calls)
MINTKEY_BROKER_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32
MINTKEY_PROXY_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32
MINTKEY_MCP_SERVICE_TOKEN=REPLACE_WITH_openssl_rand_hex_32

# broker — must match MINTKEY_BROKER_SERVICE_TOKEN above
# MINTKEY_BROKER_SERVICE_TOKEN=<same value>

# broker + proxy-plugin — admin-api base URL (must include port 8080)
MINTKEY_ADMIN_API_URL=http://admin-api:8080
