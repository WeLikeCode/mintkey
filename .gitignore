.DS_Store
*.pyc
node_modules/
**/node_modules/
dist/
__pycache__/
*.egg-info/
.venv/
.env
.env.local
# .env.test is intentionally committed — contains only localhost public URLs
# with offset ports for the dev-test namespace (no secrets).
!.env.test
data/
# Canonical agent roster — names only, no keys or secrets — committed to repo.
# git won't honour !data/seed-agents.yaml when the parent is ignored, so we
# un-ignore data/ first then re-ignore everything except this file.
!data/
data/*
!data/seed-agents.yaml
# Stray root-level Node artefacts (Playwright config lives in admin-ui/)
/package.json
/pnpm-lock.yaml
# Build artifact — never commit; rebuilt by `go build` in CI
apps/vault-adapter/vault-adapter
install-*.log

# admin-ui Playwright/test screenshot output
apps/admin-ui/screenshots-*/

# pnpm content-addressable store (local cache; created by pnpm install)
**/.pnpm-store/

# Mintkey local developer state backups — MUST never be committed (may contain secrets)
# EvidenceRef: EV-ENV-002, EV-ENV-003, EV-ENV-005, EV-BOOTSTRAP-001..006, EV-VOL-001..004
.mintkey-backups/
