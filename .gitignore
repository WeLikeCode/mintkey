.DS_Store
*.pyc
node_modules/
**/node_modules/
dist/
__pycache__/
*.egg-info/
.venv/
.env
.env.local
data/
# Stray root-level Node artefacts (Playwright config lives in admin-ui/)
/package.json
/pnpm-lock.yaml
# Build artifact — never commit; rebuilt by `go build` in CI
services/vault-adapter/vault-adapter
install-*.log

# admin-ui Playwright/test screenshot output
admin-ui/screenshots-*/

# pnpm content-addressable store (local cache; created by pnpm install)
**/.pnpm-store/

# Mintkey local developer state backups — MUST never be committed (may contain secrets)
# EvidenceRef: EV-ENV-002, EV-ENV-003, EV-ENV-005, EV-BOOTSTRAP-001..006, EV-VOL-001..004
.mintkey-backups/
