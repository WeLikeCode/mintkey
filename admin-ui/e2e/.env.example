# ── Playwright E2E test environment ──────────────────────────────────────
# Copy this file to .env.local and fill in real values before running tests.
#
# PLAYWRIGHT_BASE_URL — admin-ui endpoint (default: http://localhost:8081)
# PLAYWRIGHT_USER     — operator email for login (default: admin@mintkey.internal)
# PLAYWRIGHT_PASS     — operator password
# PLAYWRIGHT_API_JWT  — signed JWT with PlatformAdmin claims for cleanup API calls
# PLAYWRIGHT_TENANT_ID — tenant UUID for data-setup operations
# PLAYWRIGHT_OPERATOR_ID — operator UUID (from seed or admin-api /whoami)
# PLAYWRIGHT_IS_PLATFORM_ADMIN — "true" if the test user has PlatformAdmin role
# ADMIN_API_URL       — admin-api base URL (default: http://localhost:8080)
# PLAYWRIGHT_IGNORE_TLS — set "true" for self-signed certs
# ─────────────────────────────────────────────────────────────────────────

PLAYWRIGHT_BASE_URL=http://localhost:8081
PLAYWRIGHT_USER=admin@mintkey.internal
PLAYWRIGHT_PASS=
PLAYWRIGHT_API_JWT=
PLAYWRIGHT_TENANT_ID=
PLAYWRIGHT_OPERATOR_ID=
PLAYWRIGHT_IS_PLATFORM_ADMIN=true
ADMIN_API_URL=http://localhost:8080