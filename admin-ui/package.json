{
  "name": "@mintkey/admin-ui",
  "version": "1.0.0",
  "description": "Mintkey AdminJS UI — operator dashboard",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
