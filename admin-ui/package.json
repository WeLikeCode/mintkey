{
  "name": "@mintkey/admin-ui",
  "version": "0.1.0-preview.1",
  "description": "Mintkey AdminJS UI — operator dashboard",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "npx vitest run",
    "test:watch": "npx vitest",
    "test:e2e": "npx playwright test --config e2e/playwright.config.ts",
    "test:e2e:headed": "npx playwright test --headed --config e2e/playwright.config.ts",
    "test:e2e:report": "npx playwright show-report e2e/playwright-report"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "adminjs": "^7.8.13",
    "express": "^4.21.1",
    "express-formidable": "^1.2.0",
    "express-rate-limit": "7.5.0",
    "express-session": "^1.18.1",
    "jose": "^6.2.3",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "uuid": "^11.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "@tiptap/core": "2.27.2",
      "@tiptap/pm": "2.27.2",
      "@tiptap/extension-link": "2.27.2",
      "tinymce": "^7.0.0",
      "esbuild": "^0.28.0",
      "vite": "^6.4.2",
      "i18next-http-backend": "^3.0.5"
    }
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.55.1",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.0",
    "@types/node": "^22.9.0",
    "@types/supertest": "^6.0.2",
    "@types/uuid": "^10.0.0",
    "dotenv": "16.4.5",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
