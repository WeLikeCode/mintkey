    "start": "node dist/index.js",
    "test": "npx vitest run",
    "test:watch": "npx vitest"
  },
  "dependencies": {
    "@adminjs/express": "^6.1.1",
    "@adminjs/sql": "^2.2.6",
    "adminjs": "^7.8.13",
    "connect-pg-simple": "^10.0.0",
    "express": "^4.21.1",
    "express-formidable": "^1.2.0",
    "express-session": "^1.18.1",
    "jose": "^5.9.6",
    "passport": "^0.7.0",
    "passport-openidconnect": "^0.1.2",
    "pg": "^8.13.1",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "uuid": "^11.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": ["esbuild"],
