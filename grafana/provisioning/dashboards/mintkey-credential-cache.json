{
  "id": null,
  "uid": "mintkey-credential-cache",
  "title": "mintkey-credential-cache",
  "tags": ["mintkey"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "gauge",
      "title": "DEK Cache Hit Rate",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(mintkey_vault_dek_cache_hit_total[5m]) / (rate(mintkey_vault_dek_cache_hit_total[5m]) + rate(mintkey_vault_dek_cache_miss_total[5m]))",
          "legendFormat": "hit rate"
        }
      ],
      "options": {
        "minValue": 0,
        "maxValue": 1
      },
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "DEK Cache Hits vs Misses",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(mintkey_vault_dek_cache_hit_total[5m])",
          "legendFormat": "hits"
        },
        {
          "expr": "rate(mintkey_vault_dek_cache_miss_total[5m])",
          "legendFormat": "misses"
        }
      ],
      "gridPos": {"h": 8, "w": 16, "x": 8, "y": 0}
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Change Channel Subscriber Lag",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "mintkey_changes_subscriber_lag_seconds",
          "legendFormat": "{{service}} lag"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Credential Rotations (1h)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "increase(mintkey_vault_dek_cache_miss_total[1h])"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 16}
    }
  ]
}
