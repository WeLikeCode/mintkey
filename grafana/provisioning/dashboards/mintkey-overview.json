{
  "id": null,
  "uid": "mintkey-overview",
  "title": "mintkey-overview",
  "tags": ["mintkey"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Request Rate (all services)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(mintkey_requests_total[5m])) by (service)",
          "legendFormat": "{{service}}"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 0, "y": 0}
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Request Latency p99 (ms)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(mintkey_request_duration_seconds_bucket[5m])) by (le, service)) * 1000",
          "legendFormat": "{{service}} p99"
        }
      ],
      "gridPos": {"h": 8, "w": 12, "x": 12, "y": 0}
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Tokens Issued (5m rate)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(mintkey_token_issued_total[5m]))"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 0, "y": 8}
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Proxy Hits (5m rate)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(mintkey_proxy_hit_total[5m]))"
        }
      ],
      "gridPos": {"h": 4, "w": 6, "x": 6, "y": 8}
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error Rate",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "sum(rate(mintkey_requests_total{status_code=~\"5..\"}[5m])) by (service)",
          "legendFormat": "{{service}} errors"
        }
      ],
      "gridPos": {"h": 8, "w": 24, "x": 0, "y": 12}
    }
  ]
}
