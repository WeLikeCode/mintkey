  "findings": [
    {
      "severity": "major",
      "title": "Feedback FB-001 (behaviour): to_mib accepts 512mi, 1gi and non-ASCII digits",
      "detail": "Review by Claude as the owner's delegate. The requirement \"admin-api's memory limit fits its verify concurrency\" says to_mib converts an integer followed by m, M or Mi (MiB) or g, G or Gi (times 1024) and that any other string SHALL raise ValueError whose message contains the string. The pattern (\\d+)([mMgG]i?) also accepts a lowercase unit with i (512mi gives 512, 1gi gives 1024), and \\d matches non-ASCII digits (５１２m gives 512). Accept exactly the six units (for example (\\d+)(Mi|Gi|m|M|g|G) compiled with re.ASCII, still with fullmatch) and change nothing else: the other functions, their messages and the existing tests stay as they are.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-fede8b82",
      "feedback": {
        "id": "FB-001",
        "kind": "behaviour",
        "title": "to_mib accepts 512mi, 1gi and non-ASCII digits",
        "text": "Review by Claude as the owner's delegate. The requirement \"admin-api's memory limit fits its verify concurrency\" says to_mib converts an integer followed by m, M or Mi (MiB) or g, G or Gi (times 1024) and that any other string SHALL raise ValueError whose message contains the string. The pattern (\\d+)([mMgG]i?) also accepts a lowercase unit with i (512mi gives 512, 1gi gives 1024), and \\d matches non-ASCII digits (５１２m gives 512). Accept exactly the six units (for example (\\d+)(Mi|Gi|m|M|g|G) compiled with re.ASCII, still with fullmatch) and change nothing else: the other functions, their messages and the existing tests stay as they are.",
        "by": "CiprianSpot, 2026-10-25T16:08:45Z",
        "places": [
          "apps/admin-api/src/admin_api/capacity.py:14-23"
        ],
        "env": null,
        "when": "to_mib is given 512mi, 1gi, or 512m written with non-ASCII digits (the full-width ５１２m)",
        "then": "it raises ValueError whose message contains the string, as it already does for 512, 512k, '512 Mi', '' and abc; only ASCII digits followed by exactly m, M, Mi, g, G or Gi convert",
        "code": "_MEMORY_RE = re.compile(r\"(\\d+)([mMgG]i?)\")\n\n\ndef to_mib(value: str) -> int:\n    match = _MEMORY_RE.fullmatch(value)\n    if match is None:\n        raise ValueError(f\"unsupported memory value: {value!r}\")\n    amount, unit = match.groups()\n    factor = 1024 if unit[0] in (\"g\", \"G\") else 1\n    return int(amount) * factor",
        "sha256": "73a40f1d02a7315eb2716793427eb9da142211405142677bdb0af0c6590922e3",
        "retake": false
      }
    }
  ],
