  "findings": [
    {
      "severity": "major",
      "title": "Feedback FB-001 (behaviour): Unknown agent keys on the agent routes cannot slow the MCP server's key checks",
      "detail": "Today every Bearer mk_agent_* string, of any length, reaches a full Argon2id verify through the same module-level semaphore (4 slots) that /v1/internal/validate-agent-key uses, so a burst on /v1/agent/ queues the MCP server's key checks behind it.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-f9d5c71b",
      "feedback": {
        "id": "FB-001",
        "kind": "behaviour",
        "title": "Unknown agent keys on the agent routes cannot slow the MCP server's key checks",
        "text": "Today every Bearer mk_agent_* string, of any length, reaches a full Argon2id verify through the same module-level semaphore (4 slots) that /v1/internal/validate-agent-key uses, so a burst on /v1/agent/ queues the MCP server's key checks behind it.",
        "by": "CiprianSpot, 2026-11-27T23:02:12Z",
        "places": [],
        "env": null,
        "when": "requests to /v1/agent/ carry well-formed but unknown agent keys faster than they can be verified, or carry a bearer that is not mk_agent_ followed by the exact length and alphabet of a real key",
        "then": "/v1/internal/validate-agent-key is not delayed by them: the agent routes verify keys with a bounded capacity of their own, a request that finds that capacity full answers 503 mintkey:auth_unavailable at once instead of waiting, and a bearer of the wrong shape answers 401 mintkey:auth_required without a password-hash verification",
        "code": "",
        "sha256": "b88b74f9aa37593bb790e0da45216ff7bad52108cacdfa0d0a2772d88495d0ed",
        "retake": false
      }
    },
    {
      "severity": "major",
      "title": "Feedback FB-002 (behaviour): The target check of an agent-supplied URL is bounded in time and holds no database connection",
      "detail": "Today the check runs after set_tenant_context (create) or after the FOR UPDATE (update), so a slow resolver holds a pooled connection, and resolve_host has no timeout.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-c16d7dab",
      "feedback": {
        "id": "FB-002",
        "kind": "behaviour",
        "title": "The target check of an agent-supplied URL is bounded in time and holds no database connection",
        "text": "Today the check runs after set_tenant_context (create) or after the FOR UPDATE (update), so a slow resolver holds a pooled connection, and resolve_host has no timeout.",
        "by": "CiprianSpot, 2026-11-27T23:02:12Z",
        "places": [],
        "env": null,
        "when": "an agent creates or updates a service whose base_url or openapi_url names a host that resolves slowly or not at all",
        "then": "the check finishes within a bounded time and answers mintkey:target_not_allowed (unresolvable) when it runs out, and the request holds no database connection or transaction while it waits for the resolver",
        "code": "",
        "sha256": "23531c8990ecae7b38d4009887529ec2c5542420c681ae8973b922b45037ed01",
        "retake": false
      }
    },
