  "findings": [
    {
      "severity": "major",
      "title": "Feedback FB-001 (refactor): Restore the email grant queries of list_services and discover",
      "detail": "Restore both email_permission_grants queries (list_services and discover) to their form on the base branch: JOIN email_permission_grants epg ON epg.email_service_id = es.id WHERE epg.agent_id = :agent_id AND es.deleted_at IS NULL, and drop the comment above each. The subquery that adds a null expires_at under the alias pg changes no result (email grants carry no expiry) and exists only for a test helper that matched the table name as a substring; that helper is fixed in the same push, so the tests read permission_grants as a whole word and pass with the base form. Behaviour is unchanged.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-3324c8f4",
      "feedback": {
        "id": "FB-001",
        "kind": "refactor",
        "title": "Restore the email grant queries of list_services and discover",
        "text": "Restore both email_permission_grants queries (list_services and discover) to their form on the base branch: JOIN email_permission_grants epg ON epg.email_service_id = es.id WHERE epg.agent_id = :agent_id AND es.deleted_at IS NULL, and drop the comment above each. The subquery that adds a null expires_at under the alias pg changes no result (email grants carry no expiry) and exists only for a test helper that matched the table name as a substring; that helper is fixed in the same push, so the tests read permission_grants as a whole word and pass with the base form. Behaviour is unchanged.",
        "by": "CiprianSpot, 2026-11-26T21:31:15Z",
        "places": [
          "apps/mcp-server/src/mcp_server/tools/discovery.py:420-440",
          "apps/mcp-server/src/mcp_server/tools/discovery.py:516-536"
        ],
        "env": null,
        "when": null,
        "then": null,
        "code": "        for r in rows\n    ]\n\n    # Email services — union from email_permission_grants + email_services.\n    # Email grants carry no expiry yet; the subquery exposes a null `expires_at`\n    # so the same live-grant predicate applies to both discovery reads.\n    email_result = await session.execute(\n        text(\n            \"SELECT DISTINCT es.id, es.name, es.imap_host, es.smtp_host,\"\n            \" es.auth_scheme, es.allowed_recipient_domains\"\n            \" FROM email_services es\"\n            \" JOIN (\"\n            \"   SELECT eg.*, NULL::timestamptz AS expires_at\"\n            \"   FROM email_permission_grants eg\"\n            \" ) pg ON pg.email_service_id = es.id\"\n            \" WHERE pg.agent_id = :agent_id AND es.deleted_at IS NULL\"\n            \"   AND (pg.expires_at IS NULL OR pg.expires_at > now())\"\n        ),\n        {\"agent_id\": agent_ctx[\"agent_id\"]},\n    )\n    email_rows = email_result.fetchall()\n        for r in rows\n    ]\n\n    # Email services — union from email_permission_grants + email_services.\n    # Email grants carry no expiry yet; the subquery exposes a null `expires_at`\n    # so the same live-grant predicate applies to both discovery reads.\n    email_result = await session.execute(\n        text(\n            \"SELECT DISTINCT es.id, es.name, es.imap_host, es.smtp_host,\"\n            \" es.auth_scheme, es.allowed_recipient_domains\"\n            \" FROM email_services es\"\n            \" JOIN (\"\n            \"   SELECT eg.*, NULL::timestamptz AS expires_at\"\n            \"   FROM email_permission_grants eg\"\n            \" ) pg ON pg.email_service_id = es.id\"\n            \" WHERE pg.agent_id = :agent_id AND es.deleted_at IS NULL\"\n            \"   AND (pg.expires_at IS NULL OR pg.expires_at > now())\"\n        ),\n        {\"agent_id\": agent_ctx[\"agent_id\"]},\n    )\n    email_rows = email_result.fetchall()",
        "sha256": "a964bd6d48451a967965a0f1a16b2de8c9ab2e57986ea0dda90249ab2aca103b",
        "retake": false
      }
    }
  ],
