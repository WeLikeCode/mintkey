  "findings": [
    {
      "severity": "major",
      "title": "Feedback FB-001 (behaviour): The transfer and role answers show the state after the change",
      "detail": "transfer_service_ownership answers with the row it selected before its UPDATE, so the body still shows the previous owner, the previous updated_at and current_key_version 0 (the transfer SELECT lacks the key-version subquery). The role PATCH patches only role into the old row, so its updated_at is the previous one. Build both answers from the stored state after the update (for example select the row again in the same transaction). In _service_row_to_dict, read row.current_key_version again instead of getattr(..., 0), so a SELECT without that column fails instead of answering 0.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-f0928bd4",
