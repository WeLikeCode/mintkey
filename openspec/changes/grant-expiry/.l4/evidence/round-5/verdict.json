  "findings": [
    {
      "severity": "major",
      "title": "Feedback FB-002 (refactor): Bind the grantor filter values as parameters",
      "detail": "The grantor_agent_id filter of the permission listing compares grantor_type and grantor_id with literal_column(f\"'...'\") built from the value. Compare them with bound parameters instead: grantor_type with the constant GRANTOR_AGENT and grantor_id with the normalised uuid (uuid.UUID(grantor_uuid), so every accepted spelling of the id reaches the database as one canonical value). Behaviour is unchanged for every id the route accepts today; the statement no longer carries the value as SQL text.",
      "source": "feedback",
      "criterion": null,
      "log": null,
      "spec_gap": false,
      "suggested_fix": "",
      "id": "F-cf97605d",
      "feedback": {
        "id": "FB-002",
        "kind": "refactor",
        "title": "Bind the grantor filter values as parameters",
        "text": "The grantor_agent_id filter of the permission listing compares grantor_type and grantor_id with literal_column(f\"'...'\") built from the value. Compare them with bound parameters instead: grantor_type with the constant GRANTOR_AGENT and grantor_id with the normalised uuid (uuid.UUID(grantor_uuid), so every accepted spelling of the id reaches the database as one canonical value). Behaviour is unchanged for every id the route accepts today; the statement no longer carries the value as SQL text.",
        "by": "CiprianSpot, 2026-11-26T22:09:08Z",
        "places": [
          "apps/admin-api/src/admin_api/api/permissions.py:388-402"
        ],
        "env": null,
        "when": null,
        "then": null,
        "code": "    if grantor_agent_id is not None:\n        try:\n            grantor_uuid = _decode_agent_wire_id(grantor_agent_id, \"agent_\")\n            uuid.UUID(grantor_uuid)\n        except (ValueError, AttributeError, TypeError):\n            return JSONResponse(\n                status_code=422,\n                content={\"mintkey:code\": \"invalid_id\", \"title\": \"Invalid agent_id\"},\n            )\n        # The validated UUID is safe to render: the grantor filter is a\n        # constant comparison, and the grant list keeps one statement shape.\n        stmt = stmt.where(\n            pg_table.c.grantor_type == literal_column(f\"'{GRANTOR_AGENT}'\"),\n            pg_table.c.grantor_id == literal_column(f\"'{grantor_uuid}'\"),\n        )",
        "sha256": "32671ab28b9a48fe87b6dfa1917f75af321d49e392043701bac570dc5e35eed6",
        "retake": false
      }
    }
  ],
